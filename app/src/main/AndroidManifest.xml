<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bakuchat.id">

    <!-- Wajib untuk WebView mengakses internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Tetap dipertahankan dari project asli, untuk notifikasi (kalau nanti
         mau diimplementasikan ulang secara native/FCM, bukan lewat delegation
         TWA yang sudah tidak dipakai lagi) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/appName"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
        android:usesCleartextTraffic="false">

        <!--
          MainActivity berbasis WebView -- pengganti LauncherActivity (TWA).
          Ini satu-satunya activity utama sekarang.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:label="@string/launcherName">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- FileProvider dipertahankan -- berguna kalau nanti WebView perlu
             fitur upload file/gambar dari dalam halaman chat -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="@string/providerAuthority"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!--
          DIHAPUS dari manifest lama karena khusus mekanisme TWA, tidak
          relevan lagi untuk WebView native:
            - ManageDataLauncherActivity
            - FocusActivity
            - WebViewFallbackActivity (ironisnya nama ini, tapi khusus
              fallback TWA -> WebView versi androidbrowserhelper, beda
              dengan WebView native yang kita pakai sekarang)
            - NotificationPermissionRequestActivity
            - DelegationService (notification delegation ke Chrome)
            - meta-data asset_statements, web_manifest_url, twa_generator,
              semua meta-data android.support.customtabs.trusted.* (splash,
              status bar color, navigation bar color, fallback strategy, dll)
            - intent-filter VIEW/BROWSABLE untuk Digital Asset Links
              verification (tidak relevan, itu khusus TWA)
        -->

    </application>
</manifest>
